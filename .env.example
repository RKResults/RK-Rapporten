# ---------------------------------------------------------------
# Database. Railway vult deze zelf in zodra je een Postgres koppelt.
# ---------------------------------------------------------------
DATABASE_URL=postgresql://gebruiker:wachtwoord@localhost:5432/rkrapporten

# ---------------------------------------------------------------
# Geheime sleutel voor het inlogkoekje.
# Maak er zelf een met: openssl rand -base64 48
# ---------------------------------------------------------------
SESSION_SECRET=vervang-dit-door-een-lange-willekeurige-string

# ---------------------------------------------------------------
# De twee accounts. Worden alleen aangemaakt als de database leeg is.
# ---------------------------------------------------------------
ADMIN_EMAIL=kishan@rkresults.com
ADMIN_NAAM=Kishan
ADMIN_WACHTWOORD=kies-een-wachtwoord

EDITOR_EMAIL=dylan@rkresults.com
EDITOR_NAAM=Dylan
EDITOR_WACHTWOORD=kies-een-wachtwoord

# ---------------------------------------------------------------
# Mail versturen via Gmail.
# SMTP_PASS is een app-wachtwoord, niet je gewone wachtwoord.
# Maak er een aan op https://myaccount.google.com/apppasswords
# (werkt alleen als tweestapsverificatie aan staat)
# ---------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=kishan@rkresults.com
SMTP_PASS=app-wachtwoord-van-google
MAIL_VAN=Kishan Sansaar <kishan@rkresults.com>
# MAIL_ANTWOORD_NAAR=kishan@rkresults.com

# ---------------------------------------------------------------
# Leads die automatisch binnenkomen vanuit het Google Apps Script.
# Verzin zelf een lange willekeurige sleutel en zet dezelfde in het script.
# APP_URL gebruikt de app om de link naar het rapport terug te geven.
# ---------------------------------------------------------------
INKOMEND_SLEUTEL=verzin-een-lange-willekeurige-sleutel
APP_URL=https://rk-rapporten-production.up.railway.app

# Dit adres staat standaard in de cc als je een rapport verstuurt.
MAIL_KOPIE_NAAR=dylan@ds-results.com
